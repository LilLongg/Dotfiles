#!/usr/bin/env fish

set -l IMG_PATH "$argv[1]"
set -l IMG_NAME (basename $IMG_PATH)
set -l IMG_CACHE "$XDG_CACHE_HOME/wpp/$IMG_NAME.JPG"
ln -sf "$IMG_PATH" "$XDG_CACHE_HOME/.current_wpp"
ln -sf "$IMG_CACHE" "$XDG_DATA_HOME/assets/LOCK.JPG"
set -l THEME ("$XDG_DATA_HOME/scripts/image-theme.py" "$IMG_CACHE")

pkill mpvpaper
switch (string split . "$IMG_PATH" | tail -n1)
    case mp4 MP4
        awww kill
        if not test -f "$IMG_CACHE"
            ffmpeg -i "$IMG_PATH" -vf "select=eq(n\,0)" -q:v 1 "$IMG_CACHE"
        end
        mpvpaper -o "--loop-playlist --panscan=1.0" '*' "$IMG_PATH" >/dev/null &
    case gif GIF
        if not awww query
            awww-daemon &
            awww img --transition-type random "$IMG_PATH" >/dev/null
        end
        if not test -f "$IMG_CACHE"
            ffmpeg -i "$IMG_PATH" -vframes 1 "$IMG_CACHE"
        end
        awww img --transition-type random "$IMG_PATH" >/dev/null &
    case '*'
        if not awww query
            awww-daemon &
            awww img --transition-type random "$IMG_PATH" >/dev/null
        end
        if not test -f "$IMG_CACHE"
            ffmpeg -i "$IMG_PATH" "$IMG_CACHE"
        end
        awww img --transition-type random "$IMG_PATH" >/dev/null &
end

if [ "$THEME" = dark ]
    set -g GTK_THEME adw-gtk3-dark
    set -g ICON_THEME Papirus-Dark
    set -g PREFERED_SCHEME \'prefer-dark\'
    wallust run "$IMG_CACHE" --colorspace lchmixed --check-contrast
    pywalfox dark && pywalfox update &
else
    set -g GTK_THEME adw-gtk3
    set -g ICON_THEME Papirus-Light
    set -g PREFERED_SCHEME \'prefer-light\'
    wallust run "$IMG_CACHE" --colorspace salience --palette saliencelight
    pywalfox light && pywalfox update &
end

pkill -USR1 hx &
pkill -USR2 cava &
mmsg dispatch reload_config &
systemctl --user set-environment QS_ICON_THEME="$ICON_THEME" && systemctl --user restart quickshell.service &

if [ (dconf read /org/gnome/desktop/interface/color-scheme) = "$PREFERED_SCHEME" ]
    if [ "$THEME" = dark ]
        dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'" && dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
        dconf write /org/gnome/desktop/interface/icon-theme "'Papirus-Light'" && dconf write /org/gnome/desktop/interface/icon-theme "'Papirus-Dark'"
    else
        dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'" && dconf write /org/gnome/desktop/interface/color-scheme "'prefer-light'"
        dconf write /org/gnome/desktop/interface/icon-theme "'Papirus-Dark'" && dconf write /org/gnome/desktop/interface/icon-theme "'Papirus-Light'"
    end
else
    dconf write /org/gnome/desktop/interface/gtk-theme "'$GTK_THEME'"
    dconf write /org/gnome/desktop/interface/icon-theme "'$ICON_THEME'"
    dconf write /org/gnome/desktop/interface/color-scheme "$PREFERED_SCHEME"
end
"$XDG_DATA_HOME/scripts/update-icons.py"
