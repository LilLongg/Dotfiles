#!/usr/bin/env bash

WPP_DIR="$XDG_WALLPAPER_DIR"
WPP_BACKEND="$XDG_BIN_HOME/bgaction"
ROFI_THEME="$XDG_CONFIG_HOME/rofi/wallpaper.rasi"

mapfile -d '' WPPS < <(find -L "${WPP_DIR}" -maxdepth 1 -type f ! -name "*.git*" -print0 | sort -z)
ROFI_CMD="rofi -i -show -dmenu -config $ROFI_THEME"

menu() {
	for WPP in "${WPPS[@]}"; do
		WPP_NAME=$(basename "$WPP")
		WPP_CACHE="$XDG_WPP_CACHE_DIR/$WPP_NAME.png"
		printf "%s\x00icon\x1f%s\n" "$WPP_NAME" "$WPP_CACHE"
	done
}

CHOICE=$(menu | $ROFI_CMD)

if [[ -z "$CHOICE" ]]; then
	exit 0
fi

CHOICE=$(find "$WPP_DIR" -name "$CHOICE")
WPP_CMD="$WPP_BACKEND $CHOICE"
fish -lc "$WPP_CMD"
