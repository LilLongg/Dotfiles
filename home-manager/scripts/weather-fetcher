#!/usr/bin/env python


import json
from os import environ
from sys import exit
from pathlib import Path
from subprocess import CalledProcessError, run

from PyQt6.QtCore import QUrl


ICON_CACHE_DIR = Path(environ["XDG_CACHE_HOME"]) / "weather_icon"
ICON_CACHE_DIR.mkdir(parents=True, exist_ok=True)

try:
    raw_data = run(
        ["curl", "wttr.is/?format=j2"], capture_output=True, text=True, check=True
    ).stdout
except CalledProcessError:
    exit(1)

data = json.loads(raw_data)
current_data = data["current_condition"][0]
current_temp = current_data["FeelsLikeC"]
current_icon_url = current_data["weatherIconUrl"][0]["value"]
current_icon = current_icon_url.split("/")[-1]
cache_icon = ICON_CACHE_DIR / current_icon
if not cache_icon.exists():
    run(["wget2", "-q", "-P", ICON_CACHE_DIR, current_icon_url], check=False)

output = {
    "current_temp": current_temp,
    "current_icon": QUrl.fromLocalFile(str(cache_icon)).toString()
    if cache_icon.exists()
    else current_icon_url,
}
print(json.dumps(output))
