#!/usr/bin/env python

from os import environ
from sys import exit, stderr
from json import loads
from pathlib import Path
from argparse import ArgumentParser
from subprocess import CalledProcessError, run


try:
    run(["pgrep", "-f", "wlr-shot screenshot"], check=True)
except CalledProcessError:
    pass
else:
    print("Another instance of screenshot is running", file=stderr)
    exit(1)


PROG_NAME = "screenshot"
PROG_NAME_FMT = PROG_NAME.capitalize()
ABORTED_MSG = "Screenshot aborted"
FILENAME = run(
    ["date", "+%Y-%m-%d_%H-%M-%S.png"], check=False, capture_output=True, text=True
).stdout.strip()
screenshot_cmd = ["wlr-shot", "screenshot"]
current_client_data = loads(
    run(
        ["mmsg", "get", "focusing-client"],
        check=False,
        capture_output=True,
        text=True,
    ).stdout
)


def notify(body: str, *extra_args: str) -> None:
    run(
        ["notify-send", "-a", PROG_NAME_FMT, PROG_NAME_FMT, body, *extra_args],
        check=False,
    )


parser = ArgumentParser(
    PROG_NAME, description="Capture an area/window/fullscreen as an image"
)
target = parser.add_mutually_exclusive_group()

parser.add_argument(
    "-s",
    "--save",
    action="store_true",
    help="Save image to disk instead of to clipboard",
)
target.add_argument(
    "-w",
    "--window",
    action="store",
    const=current_client_data["foreign_toplevel_id"],
    help="Screenshot the current focus window (default to current focus client), conflicts with `-o`",
    nargs="?",
)
target.add_argument(
    "-o",
    "--output",
    action="store",
    const=current_client_data["monitor"],
    help="Screenshot the current output (default to current focus monitor), conflicts with `-w`",
    nargs="?",
)

args = parser.parse_args()
if args.window or args.output:
    if args.window:
        screenshot_cmd.extend(["-w", args.window])
    else:
        screenshot_cmd.extend(["-o", args.output])
else:
    screenshot_cmd.append("-s")

if args.save:
    OUTPUT = Path(environ["XDG_SCREENSHOTS_DIR"]) / FILENAME
    MSG = f"Screenshot saved to {OUTPUT}"
else:
    OUTPUT = Path("/tmp") / FILENAME
    MSG = "Screenshot saved to clipboard"
screenshot_cmd.append(OUTPUT)

try:
    run(screenshot_cmd, check=True)
    if args.save:
        notify(MSG, "-i", str(OUTPUT))
    else:
        run(["sh", "-c", f"wl-copy < {OUTPUT}"], check=True)
        notify(MSG, "-i", str(OUTPUT))
        OUTPUT.unlink()
except CalledProcessError:
    notify(ABORTED_MSG)
