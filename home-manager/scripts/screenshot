#!/usr/bin/env python

from os import environ
from sys import exit
from json import loads
from pathlib import Path
from argparse import ArgumentParser
from subprocess import CalledProcessError, run


PROG_NAME = "screenshot"
PROG_NAME_FMT = PROG_NAME.capitalize()
ABORTED_MSG = "Screenshot aborted"
FILENAME = run(
    ["date", "+%Y-%m-%d_%H-%M-%S.png"], check=False, capture_output=True, text=True
).stdout.strip()
screenshot_cmd = ["wlr-shot", "screenshot"]


def notify(body: str, *extra_args: str) -> None:
    run(
        ["notify-send", "-a", PROG_NAME_FMT, PROG_NAME_FMT, body, *extra_args],
        check=False,
    )


parser = ArgumentParser(
    PROG_NAME, description="Capture an area/window/fullscreen as an image"
)
parser.add_argument(
    "-s",
    "--save",
    action="store_true",
    help="Save image to disk instead of to clipboard",
)
parser.add_argument(
    "-w",
    "--window",
    action="store_true",
    help="Screenshot the current focus window (conflicts with `-o`)",
)
parser.add_argument(
    "-o",
    "--output",
    action="store_true",
    help="Screenshot the current output (conflicts with `-w`)",
)
args = parser.parse_args()

if args.window and args.output:
    print(f"{PROG_NAME}: error: cannot capture window and output simultaneously")
    parser.print_help()
    exit(1)

if args.window or args.output:
    data = loads(
        run(
            ["mmsg", "get", "focusing-client"],
            check=False,
            capture_output=True,
            text=True,
        ).stdout
    )
    if args.window:
        screenshot_cmd.extend(["-w", data["foreign_toplevel_id"]])
    else:
        screenshot_cmd.extend(["-o", data["monitor"]])
else:
    screenshot_cmd.append("-s")

if args.save:
    OUTPUT = Path(environ["XDG_SCREENSHOTS_DIR"]) / FILENAME
    MSG = f"Screenshot saved to {OUTPUT}"
else:
    OUTPUT = Path("/tmp") / FILENAME
    MSG = "Screenshot saved to clipboard"
screenshot_cmd.append(OUTPUT)

try:
    run(screenshot_cmd, check=True)
    notify(MSG, "-i", str(OUTPUT))
    if not args.save:
        run(["sh", "-c", f"wl-copy < {OUTPUT}"], check=False)
        OUTPUT.unlink()
except CalledProcessError:
    notify(ABORTED_MSG)
