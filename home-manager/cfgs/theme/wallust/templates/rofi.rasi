* {
    lightfg:                     {{ color7 }};
    lightbg:                     {{ color1 }};
    selected:                    {{ color1 }};
    foreground:                  {{ foreground }};
    background:                  {{ background | blend(cursor) | blend(background) }};
    alternate-background:        {{ color1 | blend(color5) }};
    background-color:            rgba ( {{ background | blend(cursor) | blend(background) | red }}, {{ background | blend(cursor) | blend(background) | green }}, {{ background | blend(cursor) | blend(background) | blue }}, 85 % );
    separatorcolor:              @foreground;
    border-color:                @foreground;
    selected-normal-foreground:  @lightbg;
    selected-normal-background:  @lightfg;
    selected-active-foreground:  @background;
    selected-active-background:  @selected;
    selected-urgent-foreground:  @background;
    selected-urgent-background:  @selected;
    normal-foreground:           @foreground;
    normal-background:           @background;
    active-foreground:           @selected;
    active-background:           @background;
    urgent-foreground:           @selected;
    urgent-background:           @background;
    alternate-normal-foreground: @foreground;
    alternate-normal-background: @background;
    alternate-active-foreground: @selected;
    alternate-active-background: @background;
    alternate-urgent-foreground: @selected;
    alternate-urgent-background: @background;
}
